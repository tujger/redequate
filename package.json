{
    "name": "redequate",
    "version": "1.2.14",
    "description": "Redequate - React PWA core by Edeqa",
    "author": "tujger",
    "license": "MIT",
    "repository": "tujger/redequate",
    "main": "core/index.js",
    "examples_main": "core/examples/index.js",
    "engines": {
        "node": ">=8",
        "npm": ">=5"
    },
    "scripts": {
        "test core": "cross-env CI=1 NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
        "test:watch core": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
        "build core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c",
        "core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c -w",
        "start core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c -w",
        "prepare core": "npm run build core",
        "predeploy core": "cd example && npm install && npm run build",
        "deploy core": "gh-pages -d example/build",
        "build and publish": "npm version patch --no-git-tag-version&&rollup -c && npm publish"
    },
