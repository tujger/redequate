    "scripts": {
        "test core": "cross-env CI=1 react-scripts test --env=jsdom",
        "test:watch core": "react-scripts test --env=jsdom",
        "build core": "rollup -c",
        "core": "rollup -c -w",
        "start core": "rollup -c -w",
        "predeploy core": "cd example && npm install && npm run build",
        "deploy core": "gh-pages -d example/build",
        "build and publish": "npm version patch --no-git-tag-version&&rollup -c && npm publish",
        "check updates": "npx npm-check-updates --dep prod&&npx npm-check-updates --dep peer&&npx npm-check-updates --dep dev",
        "update": "npm update"
    },
