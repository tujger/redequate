{
    "name": "redequate",
    "version": "2.0.20",
    "description": "Redequate - React PWA core by Edeqa",
    "author": "tujger",
    "license": "MIT",
    "repository": "tujger/redequate",
    "main": "core/index.js",
    "module": "core/index.es.js",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "examples_main": "core/examples/index.js",
    "engines": {
        "node": ">=8",
        "npm": ">=5"
    },
    "scripts": {
        "test core": "cross-env CI=1 NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
        "test:watch core": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
        "build core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c",
        "core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c -w",
        "start core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c -w",
        "prepare core": "npm run build core",
        "predeploy core": "cd example && npm install && npm run build",
        "deploy core": "gh-pages -d example/build",
        "relink": "npm install --install-links=false --legacy-peer-deps && sh ./link-redequate-react.sh \"${REDEQUATE_PROJECT:-../thewhiskytalks}\"",
        "build and publish": "npm version patch --no-git-tag-version&&rollup -c && npm publish --registry=https://registry.npmjs.org/ --access public"
    },
    "dependencies": {
        "@mui/icons-material": "^9.4.0",
        "axios": "^0.21.1",
        "firebase": "^7.19.0",
        "firebase-key": "^2.0.2",
        "i18next-browser-languagedetector": "^6.0.0",
        "react-add-to-calendar-hoc": "^1.0.10",
        "react-device-detect": "^2.2.3",
        "react-image-file-resizer": "^0.4.8",
        "react-intersection-observer": "^11.0.1",
        "react-ios-pwa-prompt": "^2.0.6",
        "react-mentions": "^4.4.10",
        "react-text-mask": "^5.5.0",
        "react-use-web-share": "^1.0.2",
        "react-uuid": "^1.0.2",
        "text-mask-addons": "^3.8.0"
    },
    "peerDependencies": {
        "@mui/material": "^9.4.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@uppy/core": "^1.13.1",
        "@uppy/dashboard": "^1.12.5",
        "@uppy/progress-bar": "^1.3.18",
        "@uppy/transloadit": "^1.6.8",
        "@uppy/tus": "^1.7.5",
        "@uppy/webcam": "^1.6.11",
        "@uppy/xhr-upload": "^1.6.3",
        "ajv": "^8.20.0",
        "ajv-keywords": "^5.1.0",
        "device-uuid": "^1.0.4",
        "i18next": "^19.8.4",
        "moment": "^2.27.0",
        "notistack": "^3.0.2",
        "prop-types": "^15.7.2",
        "react": "^18.3.1 || ^19.0.0",
        "react-datepicker": "^9.1.0",
        "react-dom": "^18.3.1 || ^19.0.0",
        "react-i18next": "^11.8.5",
        "react-image-lightbox": "^5.1.1",
        "react-linkify": "^1.0.0-alpha",
        "react-redux": "^8.1.3",
        "react-router-dom": "^5.2.0",
        "react-smart-gallery": "^0.2.0",
        "react-timekeeper": "^2.1.1",
        "react-use-gesture": "^7.0.15",
