{
    "name": "redequate",
    "version": "2.0.20",
    "description": "Redequate - React PWA core by Edeqa",
    "author": "tujger",
    "license": "MIT",
    "repository": "tujger/redequate",
    "main": "core/index.js",
    "module": "core/index.es.js",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "examples_main": "core/examples/index.js",
    "engines": {
        "node": ">=24.12.0",
        "npm": ">=5"
    },
    "scripts": {
        "test core": "npm test",
        "test:watch core": "vitest --watch --config src/__tests__/vitest.config.mjs",
        "build core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c rollup.config.mjs",
        "core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c rollup.config.mjs -w",
        "start core": "cross-env NODE_OPTIONS=--openssl-legacy-provider rollup -c rollup.config.mjs -w",
        "prepare core": "npm run build core",
        "predeploy core": "npm run \"build core\" && npm --prefix example ci --legacy-peer-deps && npm --prefix example run build",
        "deploy core": "gh-pages -d example/build",
        "build and publish": "npm version patch --no-git-tag-version&&rollup -c rollup.config.mjs && npm publish --registry=https://registry.npmjs.org/ --access public",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "vitest run --config src/__tests__/vitest.config.mjs",
        "test:integration": "node src/__tests__/test-emulators.mjs",
        "test:integration:watch": "node src/__tests__/test-emulators.mjs --watch"
    },
    "dependencies": {
        "@mui/icons-material": "^9.4.0",
        "axios": "^1.20.0",
        "firebase": "^13.0.0",
        "firebase-key": "^2.0.2",
        "i18next-browser-languagedetector": "^8.2.1",
        "react-add-to-calendar-hoc": "^1.0.10",
        "react-device-detect": "^2.2.3",
        "react-image-file-resizer": "^0.4.8",
        "react-intersection-observer": "^11.0.1",
        "react-ios-pwa-prompt": "^2.0.6",
        "react-mentions": "^4.4.10",
        "react-text-mask": "^5.5.0",
        "text-mask-addons": "^3.8.0",
        "uuid": "^14.0.2"
    },
    "peerDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^9.4.0",
        "@uppy/core": "^6.2.0",
        "@uppy/dashboard": "^6.0.1",
        "@uppy/webcam": "^6.0.1",
        "@use-gesture/react": "^10.3.1",
        "ajv": "^8.20.0",
        "ajv-keywords": "^5.1.0",
        "device-uuid": "^3.0.6",
        "i18next": "^26.4.2",
        "moment": "^2.31.0",
        "notistack": "^3.0.2",
        "react": "^18.3.1 || ^19.0.0",
        "react-datepicker": "^9.1.0",
        "react-dom": "^18.3.1 || ^19.0.0",
        "react-i18next": "^17.0.16",
        "react-image-lightbox": "^5.1.1",
        "react-linkify": "^1.0.0-alpha",
        "react-redux": "^8.1.3",
        "react-router-dom": "^5.2.0",
        "react-smart-gallery": "^0.2.0",
        "react-timekeeper": "^2.1.1",
        "redux": "^4.2.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/eslint-parser": "^7.29.9",
        "@babel/plugin-proposal-export-default-from": "^7.29.7",
        "@babel/plugin-transform-nullish-coalescing-operator": "^7.29.7",
        "@babel/plugin-transform-optional-chaining": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/eslintrc": "3.3.7",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-url": "^8.0.2",
        "@svgr/rollup": "^8.1.0",
        "@testing-library/dom": "10.4.1",
        "@uppy/core": "^6.2.0",
        "@uppy/dashboard": "^6.0.1",
        "@uppy/webcam": "^6.0.1",
        "@use-gesture/react": "^10.3.1",
        "cross-env": "^7.0.2",
        "device-uuid": "^3.0.6",
        "eslint": "^9.39.5",
        "eslint-config-standard": "17.1.0",
        "eslint-config-standard-react": "13.0.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^18.4.1",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.5",
        "firebase-tools": "13.4.0",
        "gh-pages": "^1.2.0",
        "globals": "^17.13.0",
        "i18next": "^26.4.2",
        "jsdom": "27.0.1",
        "moment": "^2.31.0",
        "postcss": "^8.5.29",
        "postcss-nested": "^8.0.1",
        "react": "^19.3.0",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.16",
        "react-redux": "^8.1.3",
        "react-router-dom": "5.3.4",
        "react-timekeeper": "2.1.1",
        "redux": "^4.2.1",
        "rollup": "^4.64.2",
        "rollup-plugin-delete": "^3.0.2",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.3"
    },
    "files": [
        "core"
    ],
    "exports": {
        ".": {
            "import": "./core/index.es.js",
            "require": "./core/index.js"
        },
        "./auth": {
            "import": "./core/auth/index.mjs",
            "require": "./core/auth/index.cjs"
        },
        "./auth/firebase": {
            "import": "./core/auth/firebase.mjs",
            "require": "./core/auth/firebase.cjs"
        },
        "./auth/local-test": {
            "import": "./core/auth/local-test.mjs",
            "require": "./core/auth/local-test.cjs"
        },
        "./backend": {
            "import": "./core/backend/index.mjs",
            "require": "./core/backend/index.cjs"
        },
        "./backend/firebase-client": {
            "import": "./core/backend/firebase-client.mjs",
            "require": "./core/backend/firebase-client.cjs"
        },
        "./backend/local-test-client": {
            "import": "./core/backend/local-test-client.mjs",
            "require": "./core/backend/local-test-client.cjs"
        },
        "./messaging": {
            "import": "./core/messaging/index.mjs",
            "require": "./core/messaging/index.cjs"
        },
        "./messaging/firebase": {
            "import": "./core/messaging/firebase.mjs",
            "require": "./core/messaging/firebase.cjs"
        },
        "./messaging/local-test": {
            "import": "./core/messaging/local-test.mjs",
            "require": "./core/messaging/local-test.cjs"
        },
        "./storage": {
            "import": "./core/storage/index.mjs",
            "require": "./core/storage/index.cjs"
        },
        "./storage/firebase": {
            "import": "./core/storage/firebase.mjs",
            "require": "./core/storage/firebase.cjs"
        },
        "./storage/local-test": {
            "import": "./core/storage/local-test.mjs",
            "require": "./core/storage/local-test.cjs"
        },
        "./_common": null,
        "./_common/*": null,
        "./core/_common/*": null,
        "./core/chunks/*": null,
        "./core/*.js": "./core/*.js",
        "./core/*": "./core/*.js",
        "./package.json": "./package.json"
    }
}
