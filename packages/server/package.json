{
    "name": "redequate-server",
    "version": "1.0.0",
    "private": true,
    "description": "Independent common, database and backend entry points for Redequate Functions",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/tujger/redequate.git",
        "directory": "packages/server"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "exports": {
        "./common": {
            "import": "./dist/common/index.mjs",
            "require": "./dist/common/index.cjs"
        },
        "./backend/common": {
            "import": "./dist/backend/common.mjs",
            "require": "./dist/backend/common.cjs"
        },
        "./backend/common-server": {
            "import": "./dist/backend/common-server/index.mjs",
            "require": "./dist/backend/common-server/index.cjs"
        },
        "./backend/firebase-server": {
            "import": "./dist/backend/firebase-server/index.mjs",
            "require": "./dist/backend/firebase-server/index.cjs"
        },
        "./database": {
            "import": "./dist/database/index.mjs",
            "require": "./dist/database/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm --prefix ../.. run \"build server\" --",
        "watch": "npm run build -- --watch",
        "pack": "npm run build && npm pack ./dist",
        "check updates": "npx npm-check-updates --dep prod&&npx npm-check-updates --dep dev"
    }
}
