{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      ".read": true
    },
    "users_public": {
      ".read": "auth != null",
      ".write": true
    },
    "users_private": {
      "$user_id": {
        ".read": "auth != null && auth.uid === $user_id",
        ".write": "auth != null && auth.uid === $user_id"
      }
    },
    "database_write_only": {
      "$record_id": {
        ".write": "!data.exists()"
      }
    },
    "database_test": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "type",
        "score",
        "nested/name"
      ]
    }
  }
}
